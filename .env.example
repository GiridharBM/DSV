# Optional runtime tuning (defaults shown)
# Cap on training rows sampled from pre-holdout years; full holdout year is always used.
RAIP_MAX_MODEL_ROWS=150000
# Number of holdout rows passed to SHAP for global/category importance.
RAIP_SHAP_ROWS=1500

# Cloud / clean-environment bootstrap. Set to 0 to disable automatic download.
RAIP_AUTO_DOWNLOAD=1
# Years fetched when the processed CSV is absent (comma-separated).
RAIP_AUTO_DOWNLOAD_YEARS=2023,2024,2025
